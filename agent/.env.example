# Agent envs
PORT=8080

# MODEL_PROVIDER=bedrock (default) uses AWS Bedrock with the full tool set (calculator, letter
# counter, EVM/crypto tools, MCP servers). MODEL_PROVIDER=ollama talks to a local Ollama server's
# OpenAI-compatible endpoint instead, with only calculator + letterCounter wired up — no AWS/RPC
# credentials needed.
MODEL_PROVIDER=bedrock

## Bedrock provider envs (used when MODEL_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
EXCHANGE_RATE_MCP_URL="http://localhost:8081/mcp"

## Ollama provider envs (used when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434/v1" # point at your Ollama host:port + /v1
OLLAMA_MODEL_ID=qwen3:1.7b

# HTTP MCP Server envs
HTTP_MCP_PORT=8081
NODE_TLS_REJECT_UNAUTHORIZED=0 # Local development only - allows self-signed certificates

# Optional
## x402 MCP Server envs
X402_APP_URL="https://j14d7ms014.execute-api.us-east-1.amazonaws.com"
EVM_PRIVATE_KEY= # For development purposes only - DO NOT USE IN PRODUCTION - DO NOT PUT YOUR KEY IN THE ENV FILE!
EVM_RPC_URL="https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID"